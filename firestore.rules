rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'avatarUrl', 'skin', 'theme', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 2048 &&
             data.skin is string && data.skin.size() <= 50 &&
             data.theme is string && data.theme.size() <= 50 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.displayName is string && data.displayName.size() <= 50 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 2048 &&
             data.skin is string && data.skin.size() <= 50 &&
             data.theme is string && data.theme.size() <= 50 &&
             data.createdAt == existing().createdAt &&
             data.updatedAt == request.time;
    }

    function isValidScoreRecord(data) {
      return data.keys().hasAll(['userId', 'score', 'timePlayed', 'name', 'color', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.userId == request.auth.uid &&
             data.score is number &&
             data.timePlayed is number &&
             data.name is string && data.name.size() <= 50 &&
             data.color is string && data.color.size() <= 50 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if true; // Public profiles for leaderboard
      allow create: if isSignedIn() && 
                    isValidId(userId) && 
                    userId == request.auth.uid && 
                    isValidUser(incoming());
      allow update: if isSignedIn() && 
                    userId == request.auth.uid && 
                    isValidUserUpdate(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'skin', 'theme', 'updatedAt']);
    }

    match /leaderboard/{scoreId} {
      allow read: if true; // Public leaderboard
      allow create: if isSignedIn() && 
                    isValidId(scoreId) && 
                    isValidScoreRecord(incoming()) &&
                    exists(/databases/$(database)/documents/users/$(request.auth.uid));
      // Scores are immutable
      allow update, delete: if false;
    }
  }
}
